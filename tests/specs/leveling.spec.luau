local Loader = require("../lib/Loader")
local T = require("../lib/T")
local Leveling = Loader.load("src/shared/Pure/Leveling.luau")
local Progression = Loader.load("src/shared/Config/Progression.luau")
local describe, it, expect = T.describe, T.it, T.expect

describe("Leveling", function()
	local curve = Progression.AccountCurve
	it("needed() follows base + step*(L-1)", function()
		expect(Leveling.needed(curve, 1)).toBe(1000)
		expect(Leveling.needed(curve, 2)).toBe(1150)
	end)
	it("adds xp without leveling below threshold", function()
		local s, gained = Leveling.add({ level = 1, xp = 0 }, 999, curve, 70)
		expect(s.level).toBe(1)
		expect(s.xp).toBe(999)
		expect(gained).toBe(0)
	end)
	it("carries overflow across multiple levels", function()
		local s, gained = Leveling.add({ level = 1, xp = 0 }, 1000 + 1150 + 5, curve, 70)
		expect(s.level).toBe(3)
		expect(s.xp).toBe(5)
		expect(gained).toBe(2)
	end)
	it("clamps at max level", function()
		local s = Leveling.add({ level = 69, xp = 0 }, 10_000_000, curve, 70)
		expect(s.level).toBe(70)
		expect(s.xp).toBe(0)
		expect(Leveling.progress(s, curve, 70).needed).toBe(0)
	end)
	it("rejects negative xp", function()
		expect(function()
			Leveling.add({ level = 1, xp = 0 }, -5, curve, 70)
		end).toThrow()
	end)
	it("total XP to level 70 is in a sane grind range (300k-600k)", function()
		local total = Leveling.totalToReach(curve, 70)
		expect(total).toBeGreaterThan(300000)
		expect(total).toBeLessThan(600000)
	end)
	it("weapon curve reaches level 30", function()
		local s = Leveling.add({ level = 1, xp = 0 }, Leveling.totalToReach(Progression.WeaponCurve, 30), Progression.WeaponCurve, 30)
		expect(s.level).toBe(30)
	end)
end)
return nil
