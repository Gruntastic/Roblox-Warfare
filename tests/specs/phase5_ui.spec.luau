local Loader = require("../lib/Loader")
local T = require("../lib/T")
local R = Loader.load("src/client/UI/Phase5Rules.luau")
local Perks = Loader.load("src/shared/Config/Perks.luau")
local Killstreaks = Loader.load("src/shared/Config/Killstreaks.luau")
local Cosmetics = Loader.load("src/shared/Config/Cosmetics.luau")
local StreakRules = Loader.load("src/shared/Pure/StreakRules.luau")
local describe, it, expect = T.describe, T.it, T.expect

describe("Phase5Rules perks", function()
	it("groups the catalogue into three tiers of four, sorted by unlock level", function()
		local tiers = R.perkTiers(Perks.list)
		expect(#tiers).toBe(3)
		for tier = 1, 3 do
			expect(#tiers[tier]).toBe(4)
			for i = 2, #tiers[tier] do
				expect(tiers[tier][i - 1].unlockLevel <= tiers[tier][i].unlockLevel).toBe(true)
			end
			for _, def in tiers[tier] do
				expect(def.tier).toBe(tier)
			end
		end
	end)
	it("sums the Hardline discount and matches StreakRules.cost", function()
		expect(R.streakDiscount({ "Fleetfoot", "Quickhands", "SecondWind" }, Perks.byId)).toBe(0)
		local d = R.streakDiscount({ "Hardline", "Quickhands", "SecondWind" }, Perks.byId)
		expect(d).toBe(1)
		expect(StreakRules.cost("MortarBarrage", d)).toBe(4)
		expect(StreakRules.cost("ReconDrone", d)).toBe(2)
	end)
end)

describe("Phase5Rules streak selection", function()
	local function costOf(id: string): number
		return StreakRules.cost(id, 0)
	end
	it("adds in cost order and removes on a second toggle", function()
		local list, changed = R.toggleStreak({}, "MortarBarrage", 3, costOf)
		expect(changed).toBe(true)
		list = R.toggleStreak(list, "ReconDrone", 3, costOf)
		expect(list[1]).toBe("ReconDrone")
		expect(list[2]).toBe("MortarBarrage")
		list = R.toggleStreak(list, "ReconDrone", 3, costOf)
		expect(#list).toBe(1)
		expect(list[1]).toBe("MortarBarrage")
	end)
	it("refuses a fourth streak and never mutates its input", function()
		local full = { "ReconDrone", "CounterRecon", "MortarBarrage" }
		local out, changed = R.toggleStreak(full, "Blackout", Killstreaks.MaxEquipped, costOf)
		expect(changed).toBe(false)
		expect(#out).toBe(3)
		expect(#full).toBe(3)
		local ok = StreakRules.validate(out, 99, 0)
		expect(ok).toBe(true)
	end)
end)

describe("Phase5Rules tray", function()
	local state = {
		count = 4,
		equipped = { { id = "ReconDrone", cost = 3 }, { id = "MortarBarrage", cost = 5 }, { id = "SentryGun", cost = 6 } },
		ready = { "MortarBarrage", "ReconDrone" },
		nextId = "MortarBarrage",
		nextAt = 5,
	}
	it("builds one entry per equipped streak with key index and progress", function()
		local tray = R.tray(state)
		expect(#tray).toBe(3)
		expect(tray[1].key).toBe(1)
		expect(tray[1].ready).toBe(1)
		expect(tray[1].progress).toBe(1)
		expect(tray[1].newest).toBe(true)
		expect(tray[2].progress).toBe(0.8)
		expect(tray[2].newest).toBe(false)
		expect(tray[3].ready).toBe(0)
	end)
	it("picks by key index only when ready, and the newest for the gamepad", function()
		expect(R.pickByIndex(state, 1)).toBe("ReconDrone")
		expect(R.pickByIndex(state, 2)).toBe("MortarBarrage")
		expect(R.pickByIndex(state, 3)).toBe(nil)
		expect(R.pickByIndex(state, 4)).toBe(nil)
		expect(R.pickNewest(state)).toBe("ReconDrone")
		expect(R.pickNewest({ count = 0, equipped = {}, ready = {} })).toBe(nil)
		expect(#R.tray(nil)).toBe(0)
	end)
end)

describe("Phase5Rules cosmetics", function()
	it("describes kill camos with progress", function()
		local req = R.camoRequirement(Cosmetics.camoById.ForestSplinter, { kills = 42, headshots = 3 })
		expect(req.text).toBe("75 KILLS")
		expect(req.progress).toBe("42/75")
		expect(req.alpha).toBe(42 / 75)
	end)
	it("describes the mastery camo with headshots", function()
		local req = R.camoRequirement(Cosmetics.camoById.Gilded, { kills = 310, headshots = 12 })
		expect(req.text).toBe("300 KILLS +100 HEADSHOTS")
		expect(req.progress).toBe("300/300 · 12/100")
		local none = R.camoRequirement(Cosmetics.camoById.Gilded, nil)
		expect(none.progress).toBe("0/300 · 0/100")
	end)
	it("describes title requirements", function()
		local req = R.titleRequirement(Cosmetics.titleById.Centurion, { kills = 42 })
		expect(req.text).toBe("100 KILLS")
		expect(req.progress).toBe("42/100")
		expect(R.titleRequirement(Cosmetics.titleById.Recruit, {}).alpha).toBe(1)
	end)
	it("maps prestige to emblems and reads equipped emblems", function()
		expect(R.prestigeEmblem(0, 10)).toBe(nil)
		expect(R.prestigeEmblem(3, 10)).toBe("Prestige3")
		expect(R.prestigeEmblem(14, 10)).toBe("Prestige10")
		expect(Cosmetics.emblemById[R.prestigeEmblem(3, #Cosmetics.emblems)].glyph).toBe("III")
		expect(R.lineEmblem({ emblem = "" })).toBe(nil)
		expect(R.lineEmblem({ emblem = "Prestige2" })).toBe("Prestige2")
		expect(R.roman(4)).toBe("IV")
	end)
end)

describe("Phase5Rules misc", function()
	it("formats countdowns", function()
		expect(R.countdown(5 * 3600 + 12 * 60 + 9)).toBe("5H 12M")
		expect(R.countdown(12 * 60 + 30)).toBe("12M 30S")
		expect(R.countdown(45)).toBe("45S")
		expect(R.countdown(-3)).toBe("0S")
	end)
	it("decides effect victims and friendly activations", function()
		expect(R.isVictim("Sable", 1, "Sable", 2)).toBe(true)
		expect(R.isVictim("Talon", 1, "Sable", 2)).toBe(false)
		expect(R.isVictim(nil, 1, nil, 2)).toBe(true) -- FFA: everyone but the owner
		expect(R.isVictim(nil, 2, nil, 2)).toBe(false)
		expect(R.isFriendly("Sable", 1, "Sable", 2)).toBe(true)
		expect(R.isFriendly("Talon", 1, "Sable", 2)).toBe(false)
		expect(R.isFriendly(nil, 2, nil, 2)).toBe(true)
		expect(R.isFriendly(nil, 1, nil, 2)).toBe(false)
	end)
	it("substitutes challenge targets", function()
		expect(R.challengeText("Get %d kills", 15)).toBe("Get 15 kills")
		expect(R.challengeText("Get 15 kills", 15)).toBe("Get 15 kills")
	end)
end)
